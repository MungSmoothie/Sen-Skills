{
  "bot": {
    "bot_id": "cloud-coordinator",
    "machine": "cloud-server",
    "role": "coordinator",
    "capabilities": ["route", "summarize", "delegate"]
  },
  "redis": {
    "host": "redis.example.com",
    "port": 6379,
    "password": "",
    "db": 0,
    "ssl": false
  },
  "telegram": {
    "bot_token": "123456789:ABCdefGHIjklMNOpqrsTUVwxyz",
    "chat_id": "-1001234567890",
    "allowed_chat_ids": ["-1001234567890"]
  },
  "streams": {
    "tasks": "claw:tasks",
    "results": "claw:results",
    "errors": "claw:errors",
    "presence_prefix": "claw:presence:"
  },
  "heartbeat_interval": 20,
  "offline_threshold": 3,
  "consumer_group": "claw-workers"
}
